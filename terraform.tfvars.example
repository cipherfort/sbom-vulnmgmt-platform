# Copy this file to terraform.tfvars and fill in values for your environment.
# terraform.tfvars is gitignored — never commit real values. In CI these
# come from the TF_VARS_JSON secret (see docs/deployment-runbook.md, step 8).

# ---------- GitHub ----------
github_app_id = "123456" # cps-sbom-collector, owned by the CPS org

alert_email = "cps-platform@example.org"

# ---------- Network ----------
# Who can open the Dependency-Track UI. RFC 5737 documentation ranges
# below — replace. Leave empty to allow everyone.
# allowed_ip_ranges = ["203.0.113.0/24", "198.51.100.10/32"]

# ---------- Entra sign-in (runbook step 17) ----------
# dtrack_oidc_client_id = "<app-reg-client-id>"   # when the app registration is made by hand
# manage_entra          = true                    # or let Terraform make it (needs Graph permissions)

# ---------- Optional overrides (defaults shown) ----------
# environment        = "prd"
# global_name_suffix = ""
# dtrack_image_tag   = "4.14.6"
