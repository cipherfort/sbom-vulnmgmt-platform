# Copy this file to terraform.tfvars and fill in values for your environment.
# terraform.tfvars is gitignored — never commit real values.

# CIDR ranges allowed to reach the Dependency-Track and DefectDojo ingress.
# Required — no default. Example below uses an RFC 5737 documentation
# range; replace with your own office/VPN egress ranges (and the
# self-hosted runner's egress, if you're using cps-ubuntu-latest-private
# rather than switching the workflows to ubuntu-latest).
allowed_ip_ranges = [
  "203.0.113.0/24",
]

# Optional overrides — defaults shown, uncomment to change:
# location             = "uksouth"
# dtrack_image_tag     = "4.12.4"
# defectdojo_image_tag = "2.42.1"
