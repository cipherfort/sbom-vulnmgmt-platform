# Copy to terraform.tfvars.json (the format CI's TF_VARS_JSON secret uses),
# or to terraform.tfvars in this format. Both are git-ignored; use only one.

github_app_id = "123456"                   # the collector GitHub App's App ID
alert_email   = "cps-platform@example.org" # where collector alerts go

# Who can open the Dependency-Track UI, as CIDRs. Empty allows everyone.
# The API is not restricted; every call needs an API key.
allowed_ip_ranges = ["203.0.113.10/32"]

# Optional
# environment           = "prd"    # names become rg-sbom-prd, kv-sbom-prd, ...
# global_name_suffix    = ""       # only if a globally unique name is taken
# dtrack_image_tag      = "4.14.6"
# dtrack_oidc_client_id = ""       # Entra sign-in, once the app registration exists
# manage_entra          = false    # true: Terraform creates the Entra groups and app

# As terraform.tfvars.json:
# {
#   "github_app_id": "123456",
#   "alert_email": "cps-platform@example.org",
#   "allowed_ip_ranges": ["203.0.113.10/32"]
# }
