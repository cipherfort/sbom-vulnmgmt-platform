// Analytics rule: any repo running a package on the BannedPackages watchlist.
SbomLatest
| join kind=inner (
    _GetWatchlist("BannedPackages")
    | project PackageName = tostring(SearchKey), Reason = tostring(column_ifexists("Reason", ""))  // the column only exists once the watchlist has items
  ) on PackageName
| project Org, Repo, Branch, PackageName, PackageVersion, Purl, Reason
